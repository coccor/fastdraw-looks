// Headline. A named alternative to the built-in look: serif headline over flat newspaper-graphics blocks.
// Drawn like a newspaper graphics desk: a serif headline over flat, square, pale-grey blocks set in
// one grotesque, grey for context and one muted crimson for the subject. No shadows, no black fills.

canvas paper=paper

color paper  #ffffff
color ink    #1f2328
color muted  #5f6670
color soft   #a3a9b1
color block  #e4e7eb
color hair   #cfd4da
color accent #b3354d
color link   #45607e

font sans  "Libre Franklin"
font mono  "Geist Mono"
font serif "Newsreader"

// ---- boxes ----------------------------------------------------------------
style node shape=rect radius=2 size=144x64 fill=block stroke=none sw=0
    title.weight=700 title.size=12 title.color=ink sub.font=sans sub.size=10 sub.color=muted
    tag.font=sans tag.size=8 tag.weight=700 tag.color=muted tag.border=none
    use="default box: a service, component or step"
style focal extends node fill=accent title.color=#ffffff sub.color=#ffffff/0.85
    tag.color=#ffffff/0.85 ghost.color=#ffffff/0.15
    use="the one or two elements the diagram is about"
style store extends node size=144x72
    path="M0,0.1 C0,-0.035 1,-0.035 1,0.1 L1,0.9 C1,1.035 0,1.035 0,0.9 Z M0,0.1 C0,0.235 1,0.235 1,0.1 C1,0.235 0,0.235 0,0.1"
    shape=path stroke=#ffffff sw=1.5
    use="something that holds data or state"
style cloud extends node fill=link/0.12 title.color=link sub.color=link/0.8
    use="a hosted or third-party platform"
style external extends node fill=paper stroke=soft sw=1 dash=3,3
    use="a person or system outside what you own"
style optional extends node fill=paper stroke=hair sw=1 dash=2,3
    use="optional or asynchronous participant"
style sticky extends node size=120x120 fill=#efe3a2 title.weight=500
    use="a yellow sticky note: an idea, comment or open question"
style sticky-orange extends sticky fill=#efd2bb use="an orange sticky note: a risk or issue"
style sticky-violet extends sticky fill=#ddd8ec use="a violet sticky note: a decision or note"

// ---- flowchart shapes -----------------------------------------------------
style step extends node size=160x48 use="flowchart action"
style terminal shape=rect radius=24 size=160x48 fill=paper stroke=ink sw=1 title.weight=700 title.size=12 title.color=ink sub.font=sans sub.size=10 sub.color=muted
    use="flowchart start or end"
style terminal-focal extends terminal fill=accent stroke=accent title.color=#ffffff sub.color=#ffffff/0.85
    use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=block stroke=none title.weight=700 title.size=12
    use="flowchart yes/no question; put the text on two short lines"

// ---- other shapes ---------------------------------------------------------
style zone shape=rect radius=0 fill=none stroke=hair sw=1 dash=1,3 layer=back
    title.pos=top title.align=left title.font=sans title.size=10 title.weight=700 title.caps=1 title.spacing=0.06 title.color=muted
    use="a labelled region drawn behind a group of boxes; always give WxH"
style bar shape=rect size=8x80 fill=block stroke=none
    use="sequence diagram activation bar, centred on a lifeline; always give WxH"

style table shape=table radius=0 fill=paper stroke=hair sw=1 head.fill=block rule=hair
    cell.font=sans cell.size=10 detail.color=muted
    use="an entity, class or database table: a header and rows. One line per row: | id \"name\" \"type\" \"key\". Arrows can end on a row: orders.user_id -> users.id"
style matrix extends table align=center grid=1
    use="a grid of values: first row with |= for the column headings, first cell of each row is its name"
style chart shape=chart fill=none stroke=ink/0.6 sw=1 mask=0 bar.radius=0 grid.color=ink/0.08
    use="axes with your numbers drawn for you: chart at x,y WxH x=\"Q1,Q2,Q3\" y=0..100, then a line per series: | bars \"Revenue\" 42 61 75"

// ---- lines ----------------------------------------------------------------
style arrow line stroke=#80868f sw=1.25 route=ortho radius=4 label.font=sans label.size=10 label.caps=0 label.spacing=0 label.color=muted
    use="default arrow"
style primary extends arrow stroke=accent sw=2.25 label.color=accent label.weight=700 use="the main path; at most two per diagram"
style link extends arrow stroke=link label.color=link use="a request crossing a boundary"
style return extends arrow stroke=soft dash=3,3 use="a response, or something optional or asynchronous"
style relation extends relation stroke=#80868f label.font=sans label.size=10 label.caps=0 label.spacing=0 label.color=muted
style lifeline line head=none stroke=hair sw=1 dash=1,3 route=straight use="sequence diagram lifeline"
style rule line head=none stroke=hair sw=1 route=straight use="thin separator"

// ---- text -----------------------------------------------------------------
style h1 text font=serif size=28 weight=500 color=ink use="diagram title, a serif headline"
style kicker text font=sans size=10 weight=700 color=accent caps=1 spacing=0.08 use="optional: a short category above the title, e.g. PROCESS"
style dek text font=sans size=15 color=muted use="one line under the title that says what the diagram shows"
style eyebrow text font=sans size=10 weight=700 color=muted caps=1 spacing=0.06 use="small heading"
style caption text font=sans size=10 color=muted use="small explanatory text"
style legend extends legend rule=hair title.font=sans title.size=9 title.weight=700 title.spacing=0.06 item.font=sans item.size=10
style note text font=serif italic=1 size=15 color=muted use="a short aside; at most two"
style small text font=sans size=10 color=soft use="source line, or technical detail: a port, path or command"

guidance "focal, terminal-focal and primary are the accent. Use the accent on at most two things in one diagram."
guidance "Never fill a shape with ink to make it stand out; use the accent, or a tint such as accent/0.14 or block."
guidance "tag= is a 3 or 4 letter type marker in the corner of a box. sub= is a short second line of detail."
guidance "A title reads best with a dek under it: one plain sentence saying what the diagram shows."
guidance "Finish with a legend: one statement, 'legend at x,y' followed by style=\"what it means\" for each style you used."
