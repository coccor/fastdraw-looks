// Tiles: white square tiles with no outline on a soft shadow, a thin dark icon with a small name under it, on a pale
// lavender page. The subject is in indigo. Groups have rounded corners: zone in long grey dashes, group lavender with
// a thin indigo outline, frame a plain grey outline; each is named above its top edge beside a round lavender badge
// on its corner (give the group an icon=). status-red, status-orange and status-yellow are dots for a tile's
// corner. Lines are thick dark grey with square elbows, labelled in small capitals on dark pills; primary is teal,
// alert red. Roboto. Needs FastDraw's shadow=, icon.bg= and icon.dx=. Same style names as the built-in look.

canvas paper=paper dots=none

color paper  #f6f7fc
color card   #ffffff
color ink    #2b2b33
color muted  #6b6b78
color soft   #9d9dab
color accent #2d2a9b
color link   #2d2a9b
color teal   #1fbf9a
color amber  #f7c948
color rose   #f25c5c
color violet #6c63d9

font sans  "Roboto" "https://cdn.jsdelivr.net/fontsource/fonts/roboto@5.3.0/latin-{weight}-{style}.ttf"
font mono  "Geist Mono"
font serif "Newsreader"

// ---- boxes ----------------------------------------------------------------
style node shape=rect radius=8 size=96x88 fill=#ffffff stroke=none sw=0 sub.font=sans sub.color=muted dash=none shadow=#3b3f8c/0.16 shadow.size=8 shadow.dx=-3 shadow.dy=5 icon.pos=top icon.size=26 icon.width=1.2 title.color=ink title.size=10 title.weight=400 title.align=center sub.size=8.5
    tag.color=muted tag.border=ink/0.2 tag.font=mono icon.color=ink icon.fill=none
    use="default box: a backend, service, component or step"
style focal extends node fill=#ffffff stroke=none sw=0 title.color=accent shape=rect radius=8 size=96x88 dash=none shadow=#2d2a9b/0.22 shadow.size=8 shadow.dx=-3 shadow.dy=5 icon.pos=top icon.size=26 icon.color=accent icon.fill=none icon.width=1.2 title.size=10 title.weight=500 title.align=center sub.color=muted sub.font=sans sub.size=8.5 tag.font=mono
    tag.color=accent tag.border=accent/0.4 ghost.color=accent/0.08
    use="the one or two elements the diagram is about"
style store extends node fill=#ffffff shape=rect stroke=none icon.color=ink icon.fill=none tag.color=muted tag.border=ink/0.2 radius=8 size=96x88 sw=0 dash=none shadow=#3b3f8c/0.16 shadow.size=8 shadow.dx=-3 shadow.dy=5 icon.pos=top icon.size=26 icon.width=1.2 title.color=ink title.size=10 title.weight=400 title.align=center sub.color=muted sub.font=sans sub.size=8.5 tag.font=mono icon=database
    path=none
    use="something that holds data or state"
style cloud extends node fill=#eeeffb stroke=none icon.color=ink icon.fill=none tag.color=muted tag.border=ink/0.2 shape=rect radius=8 size=96x88 sw=0 dash=none shadow=#3b3f8c/0.16 shadow.size=8 shadow.dx=-3 shadow.dy=5 icon.pos=top icon.size=26 icon.width=1.2 title.color=ink title.size=10 title.weight=400 title.align=center sub.color=muted sub.font=sans sub.size=8.5 tag.font=mono
    use="a hosted or third-party platform"
style external extends node fill=#ffffff/0.6 stroke=soft dash=4,3 icon.color=ink icon.fill=none shape=rect radius=8 size=96x88 sw=1 shadow=none shadow.size=8 shadow.dx=-3 shadow.dy=5 icon.pos=top icon.size=26 icon.width=1.2 title.color=ink title.size=10 title.weight=400 title.align=center sub.color=muted sub.font=sans sub.size=8.5 tag.color=muted tag.border=ink/0.2 tag.font=mono
    use="a person or system outside what you own"
style optional extends node fill=none stroke=soft dash=2,3 tag.color=muted tag.border=ink/0.2 shape=rect radius=8 size=96x88 sw=1 shadow=none shadow.size=8 shadow.dx=-3 shadow.dy=5 icon.pos=top icon.size=26 icon.color=ink icon.fill=none icon.width=1.2 title.color=ink title.size=10 title.weight=400 title.align=center sub.color=muted sub.font=sans sub.size=8.5 tag.font=mono
    use="optional or asynchronous participant"
style sticky extends node radius=8 size=120x120 fill=#fff6d9 stroke=none tag.color=ink tag.border=ink/0.2 shadow=#3b3f8c/0.16 shadow.size=8 shadow.dx=-3 shadow.dy=5 title.weight=400 title.color=ink
    use="a yellow sticky note: an idea, comment or open question"
style sticky-orange extends sticky fill=#ffe6dc stroke=rose/0.35 use="an orange sticky note: a risk or issue"
style sticky-violet extends sticky fill=#ecebfb stroke=violet/0.35 use="a violet sticky note: a decision or note"

// ---- flowchart shapes -----------------------------------------------------
style step extends node size=144x56 radius=8 fill=#ffffff stroke=none shadow=#3b3f8c/0.16 shadow.size=8 shadow.dx=-3 shadow.dy=5 icon.pos=left title.weight=400 title.size=11 title.align=center use="flowchart action"
style terminal extends node radius=28 size=160x48 fill=#ffffff stroke=none shadow=#3b3f8c/0.16 shadow.size=8 shadow.dx=-3 shadow.dy=5 title.weight=400
    use="flowchart start or end"
style terminal-focal extends terminal fill=#ffffff stroke=none sw=2 title.color=accent title.weight=500
    use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=#ffffff stroke=soft sw=1 title.weight=400
    use="flowchart yes/no question; put the text on two short lines"

// ---- regions and markers --------------------------------------------------
style zone shape=rect radius=14 fill=none stroke=soft sw=1.5 layer=back dash=10,7 title.dy=-22 title.fill=none icon.pos=corner icon.size=16 icon.color=accent icon.bg=#e6e6f8 icon.bg.shape=circle icon.bg.size=34 icon.dx=-8 icon.dy=-8 icon.bg.shadow=#3b3f8c/0.18 icon.bg.shadow.size=6 icon.bg.shadow.dx=-2 icon.bg.shadow.dy=3
    title.pos=top title.align=left title.font=sans title.size=11 title.weight=500 title.color=ink title.spacing=0 title.caps=0
    use="a labelled region drawn behind a group of boxes; always give WxH"
style group shape=rect radius=14 sw=1 layer=back title.pos=top title.align=left title.font=sans title.size=11 title.weight=500 title.color=ink title.spacing=0 title.caps=0 title.dy=-22 title.fill=none icon.pos=corner icon.size=16 icon.color=accent icon.bg=#e6e6f8 icon.bg.shape=circle icon.bg.size=34 icon.dx=-8 icon.dy=-8 icon.bg.shadow=#3b3f8c/0.18 icon.bg.shadow.size=6 icon.bg.shadow.dx=-2 icon.bg.shadow.dy=3 fill=#eeeffb stroke=accent/0.6 use="an inner group: lavender with a thin indigo outline, named beside a badge on its corner; give it icon= for the badge and always WxH"
style frame shape=rect radius=14 sw=1 layer=back title.pos=top title.align=left title.font=sans title.size=11 title.weight=500 title.color=ink title.spacing=0 title.caps=0 title.dy=-22 title.fill=none icon.pos=corner icon.size=16 icon.color=accent icon.bg=#e6e6f8 icon.bg.shape=circle icon.bg.size=34 icon.dx=-8 icon.dy=-8 icon.bg.shadow=#3b3f8c/0.18 icon.bg.shadow.size=6 icon.bg.shadow.dx=-2 icon.bg.shadow.dy=3 fill=none stroke=soft use="a plain group: a thin grey outline, named beside a badge on its corner; always give WxH"
style alert extends arrow stroke=rose sw=2.2 radius=0 head=arrow head.size=0.75 label.font=sans label.size=7.5 label.weight=500 label.color=#ffffff label.caps=1 label.spacing=0.06 label.fill=rose label.border=rose label.radius=8 label.pad=6 label.sw=1 use="a line that carries a threat or a failure: red, its pill red"
style status-red shape=ellipse size=12x12 fill=rose stroke=none sw=0 use="a red status dot (critical) on a tile's bottom-right corner: put it at the tile's right-6, bottom-6"
style status-orange extends status-red fill=#f59673 use="an orange status dot (medium) on a tile's corner"
style status-yellow extends status-red fill=amber use="a yellow status dot (low) on a tile's corner"
style bar shape=rect radius=4 size=8x80 fill=#eeeffb stroke=none sw=1
    use="sequence diagram activation bar, centred on a lifeline; always give WxH"

style table shape=table radius=8 fill=#ffffff stroke=none sw=1 head.fill=#eeeffb rule=ink/0.06 shadow=#3b3f8c/0.16 shadow.size=8 shadow.dx=-3 shadow.dy=5
    cell.font=sans cell.size=10 detail.color=muted
    use="an entity, class or database table: a header and rows. One line per row: | id \"name\" \"type\" \"key\". Arrows can end on a row: orders.user_id -> users.id"
style matrix extends table align=center grid=1 cell.font=sans
    use="a grid of values: first row with |= for the column headings, first cell of each row is its name"
style chart shape=chart fill=none stroke=ink/0.5 sw=1 mask=0 bar.radius=2 grid.color=ink/0.08
    tick.font=mono tick.size=9 tick.color=muted
    use="axes with your numbers drawn for you: chart at x,y WxH x=\"Q1,Q2,Q3\" y=0..100, then a line per series: | bars \"Revenue\" 42 61 75"

// ---- lines ----------------------------------------------------------------
style arrow line stroke=#55555f sw=2.2 route=ortho radius=0 label.font=sans label.size=7.5 label.color=#ffffff label.spacing=0.06 label.caps=1 head=arrow head.size=0.75 label.weight=500 label.fill=#5f5f69 label.border=#5f5f69 label.radius=8 label.pad=6 label.sw=1
    use="default arrow"
style primary extends arrow stroke=teal sw=2 label.color=#ffffff label.fill=teal label.border=teal use="the main path; at most two per diagram"
style link extends arrow stroke=accent label.color=#ffffff sw=1.6 label.fill=accent label.border=accent use="an HTTP or API request crossing a boundary"
style return extends arrow dash=6,4 use="a response, or something optional or asynchronous"
style relation extends relation stroke=#55555f label.font=sans label.size=10 label.spacing=0 label.caps=0 sw=1.6
style lifeline line head=none stroke=soft sw=1 dash=6,4 route=straight use="sequence diagram lifeline"
style rule line head=none stroke=ink/0.1 sw=1 route=straight use="thin separator, e.g. above a legend"

// ---- text -----------------------------------------------------------------
style h1 text font=sans size=24 weight=600 spacing=-0.01 color=ink use="diagram title"
style kicker text font=sans size=10 weight=500 color=accent spacing=0 caps=0 use="optional: a short category above the title, e.g. PROCESS"
style dek text font=sans size=14 color=muted use="optional: one line under the title saying what the diagram shows"
style eyebrow text font=mono size=8 color=muted spacing=0.14 caps=1 use="small caps label, e.g. LEGEND"
style caption text font=sans size=9.5 color=muted use="small explanatory text"
style legend extends legend rule=ink/0.1 title.font=sans item.size=9.5 title.caps=0 title.spacing=0
style note text font=sans size=13 color=muted use="a short aside; at most two"
style small text font=mono size=9 color=muted use="technical detail: a port, path or command"

guidance "focal, terminal-focal and primary are the accent. Use the accent on at most two things in one diagram."
guidance "Never fill a shape with ink to make it stand out; use the accent, or a tint such as accent/0.14."
guidance "tag= is a 3 or 4 letter type marker in the corner of a box (EXT, EDGE, API, DB). Use it on architecture boxes, not flowchart shapes."
guidance "sub= is a short second line of detail: a product name, path, port or protocol. Names of things go in the main text."
guidance "kicker and dek are optional. Add a kicker only when the diagram belongs to a named category, and a dek only when there is one clear message; most diagrams need neither."
guidance "Finish with a legend: one statement, 'legend at x,y' followed by style=\"what it means\" for each style you used."
guidance "Tiles are 96x88 and hold an icon and a one- or two-word name: give every tile an icon=, and keep sub= off."
guidance "A group's name sits above its top edge beside the badge: leave 32px clear above every zone, group and frame."
guidance "A status dot goes on a tile's bottom-right corner: a tile at x,y 96x88 takes its dot at x+90,y+82."
guidance "Line labels are small capitals on pills: a protocol or one word (HTTPS, gRPC, SQL)."

// ---- icons ----------------------------------------------------------------------
