// Kubernetes: drawn the way kubernetes.io draws its diagrams. Services and workloads are solid Kubernetes-blue boxes
// with white text, people and clients grey pills, groups white frames with a grey border, and a cluster, its control
// plane and its nodes light blue panels, as in the documentation's components diagram. Dark lines with labels on grey
// plates, dotted for requests. Open Sans, the project's own icons (icon=deploy, icon=svc). Same style names as the built-in look.

canvas paper=paper dots=none

color paper  #ffffff
color card   #ffffff
color ink    #333333
color muted  #555555
color soft   #999999
color accent #326ce5
color link   #333333
color teal   #0d9488
color amber  #b45309
color rose   #be123c
color violet #6d28d9

font sans  "Open Sans" "https://cdn.jsdelivr.net/fontsource/fonts/open-sans@5.3.0/latin-{weight}-{style}.ttf"
font mono  "Geist Mono"
font serif "Newsreader"

// the resource icons from kubernetes/community (Apache 2.0) at a fixed commit, by kubectl's short names
icondir "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/{name}.svg"
    names="c-role cm crb crd cronjob deploy ds ep group hpa ing job limits netpol ns pod psp pv pvc quota rb role rs sa sc secret sts svc user vol"
icons builtin=hidden

// ---- boxes ----------------------------------------------------------------
style node shape=rect radius=0 size=144x64 fill=#326ce5 stroke=none sw=1 sub.font=sans sub.color=#ffffff/0.85 title.weight=600 title.color=#ffffff
    tag.color=#ffffff tag.border=#ffffff/0.6 tag.font=mono icon.color=#ffffff icon.fill=none
    use="default box: a backend, service, component or step"
style focal extends node fill=#326ce5 stroke=none sw=2 title.color=#ffffff sub.color=#ffffff/0.85 icon.color=#ffffff icon.fill=none inner=#ffffff inner.gap=3 inner.sw=1.2
    tag.color=#ffffff tag.border=#ffffff/0.6 ghost.color=accent/0.10
    use="the one or two elements the diagram is about"
style store extends node fill=#326ce5 shape=path stroke=none icon.color=#ffffff icon.fill=none tag.color=#ffffff tag.border=#ffffff/0.6 title.color=#ffffff sub.color=#ffffff/0.85
    path="M0,0.1 C0,-0.035 1,-0.035 1,0.1 L1,0.9 C1,1.035 0,1.035 0,0.9 Z M0,0.1 C0,0.235 1,0.235 1,0.1 C1,0.235 0,0.235 0,0.1"
    use="something that holds data or state"
style cloud extends node fill=#dddddd stroke=none icon.color=#000000 icon.fill=none tag.color=#000000 tag.border=#000000/0.4 title.color=#000000 sub.color=muted
    use="a hosted or third-party platform"
style external extends node fill=#dddddd stroke=none dash=none icon.color=#000000 icon.fill=none title.color=#000000 sub.color=muted tag.color=#000000 tag.border=#000000/0.4 radius=32
    use="a person or system outside what you own"
style optional extends node fill=#f2f2f2 stroke=#bbbbbb dash=3,3 tag.color=#000000 tag.border=#000000/0.4 title.color=#000000 sub.color=muted icon.color=#000000 icon.fill=none
    use="optional or asynchronous participant"
style sticky extends node radius=4 size=120x120 fill=#fff7d6 stroke=amber/0.35 tag.color=ink tag.border=ink/0.3 title.color=ink sub.color=muted
    use="a yellow sticky note: an idea, comment or open question"
style sticky-orange extends sticky fill=#ffe4e6 stroke=rose/0.35 use="an orange sticky note: a risk or issue"
style sticky-violet extends sticky fill=#ede9fe stroke=violet/0.35 use="a violet sticky note: a decision or note"

// ---- flowchart shapes -----------------------------------------------------
style step extends node size=160x48 fill=#326ce5 stroke=none title.color=#ffffff sub.color=#ffffff/0.85 tag.color=#ffffff tag.border=#ffffff/0.6 icon.color=#ffffff icon.fill=none use="flowchart action"
style terminal extends node radius=24 size=160x48 fill=#dddddd stroke=none title.color=#000000 sub.color=muted tag.color=#000000 tag.border=#000000/0.4 icon.color=#000000 icon.fill=none
    use="flowchart start or end"
style terminal-focal extends terminal fill=#326ce5 stroke=none sw=2 title.color=#ffffff sub.color=#ffffff/0.85 tag.color=#ffffff tag.border=#ffffff/0.6 icon.color=#ffffff icon.fill=none inner=#ffffff inner.sw=1.2
    use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=#dddddd stroke=none sw=1 title.color=#000000
    use="flowchart yes/no question; put the text on two short lines"

// ---- regions and markers --------------------------------------------------
style zone shape=rect radius=0 fill=#ffffff stroke=#bbbbbb sw=2 layer=back
    title.pos=top title.align=left title.font=sans title.size=11 title.weight=600 title.color=#326ce5 title.spacing=0 title.caps=0
    use="a labelled region drawn behind a group of boxes; always give WxH"
style cluster extends zone radius=10 fill=#d9e6fb stroke=none title.font=sans title.size=11 title.weight=700 title.spacing=0 title.caps=0 title.color=#333333 use="a Kubernetes cluster: a light blue panel; always give WxH"
style control-plane extends zone radius=10 fill=#eef4fd stroke=none title.font=sans title.size=11 title.weight=700 title.spacing=0 title.caps=0 title.color=#333333 use="the control plane: a pale panel inside a cluster; always give WxH"
style k8s-node extends zone radius=8 fill=#a3bbe3 stroke=none title.font=sans title.size=11 title.weight=700 title.spacing=0 title.caps=0 title.color=#222222 use="a worker node (a machine in the cluster): a darker blue panel; always give WxH"
style namespace extends zone use="a namespace: a white frame with a grey border; always give WxH"
style pod-group extends zone fill=none stroke=#bbbbbb dash=4,3 use="the pods of one workload drawn together; always give WxH"
style bar shape=rect radius=2 size=8x80 fill=#326ce5/0.2 stroke=#326ce5 sw=1
    use="sequence diagram activation bar, centred on a lifeline; always give WxH"

style table shape=table radius=0 fill=#ffffff stroke=#bbbbbb sw=1 head.fill=#326ce5/0.12 rule=ink/0.12
    cell.font=mono cell.size=10 detail.color=muted
    use="an entity, class or database table: a header and rows. One line per row: | id \"name\" \"type\" \"key\". Arrows can end on a row: orders.user_id -> users.id"
style matrix extends table align=center grid=1 cell.font=sans
    use="a grid of values: first row with |= for the column headings, first cell of each row is its name"
style chart shape=chart fill=none stroke=ink/0.5 sw=1 mask=0 bar.radius=2 grid.color=ink/0.08
    tick.font=mono tick.size=9 tick.color=muted
    use="axes with your numbers drawn for you: chart at x,y WxH x=\"Q1,Q2,Q3\" y=0..100, then a line per series: | bars \"Revenue\" 42 61 75"

// ---- lines ----------------------------------------------------------------
style arrow line stroke=ink sw=1.6 route=ortho radius=0 label.font=sans label.size=10 label.color=ink label.spacing=0 label.caps=0 label.fill=#e8e8e8 label.border=none
    use="default arrow"
style primary extends arrow stroke=#326ce5 sw=2.2 label.color=#1a4fc4 use="the main path; at most two per diagram"
style link extends arrow stroke=ink label.color=ink dash=2,3 use="an HTTP or API request crossing a boundary"
style return extends arrow dash=5,4 use="a response, or something optional or asynchronous"
style relation extends relation stroke=ink/0.8 label.font=sans label.size=10 label.spacing=0 label.caps=0
style lifeline line head=none stroke=ink/0.20 sw=1 dash=4,4 route=straight use="sequence diagram lifeline"
style rule line head=none stroke=ink/0.10 sw=1 route=straight use="thin separator, e.g. above a legend"

// ---- text -----------------------------------------------------------------
style h1 text font=sans size=26 weight=700 spacing=-0.03 color=ink use="diagram title"
style kicker text font=mono size=10 weight=500 color=#326ce5 spacing=0.12 caps=1 use="optional: a short category above the title, e.g. PROCESS"
style dek text font=sans size=14 color=muted use="optional: one line under the title saying what the diagram shows"
style eyebrow text font=mono size=8 color=muted spacing=0.14 caps=1 use="small caps label, e.g. LEGEND"
style caption text font=sans size=9.5 color=muted use="small explanatory text"
style legend extends legend rule=ink/0.1 title.font=mono item.size=9.5
style note text font=sans size=13 color=muted use="a short aside; at most two"
style small text font=mono size=9 color=muted use="technical detail: a port, path or command"

guidance "focal, terminal-focal and primary are the accent. Use the accent on at most two things in one diagram."
guidance "Never fill a shape with ink to make it stand out; use the accent, or a tint such as accent/0.14."
guidance "tag= is a 3 or 4 letter type marker in the corner of a box (EXT, EDGE, API, DB). Use it on architecture boxes, not flowchart shapes."
guidance "sub= is a short second line of detail: a product name, path, port or protocol. Names of things go in the main text."
guidance "kicker and dek are optional. Add a kicker only when the diagram belongs to a named category, and a dek only when there is one clear message; most diagrams need neither."
guidance "Finish with a legend: one statement, 'legend at x,y' followed by style=\"what it means\" for each style you used."
guidance "Icons are the Kubernetes project icons, by the kubectl short name or the full one: icon=deploy (deployment), svc (service), ing (ingress), pod, sts (statefulset), ds (daemonset), cm (configmap), secret, pvc, hpa, job, cronjob, ns, node, control-plane, etcd."
guidance "Draw a cluster as cluster, with control-plane and k8s-node panels inside; namespace and zone are plain frames; pod-group gathers the replicas of one workload."

// ---- icons ----------------------------------------------------------------------
icon control-plane "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/infrastructure_components/unlabeled/control-plane.svg"
icon etcd "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/infrastructure_components/unlabeled/etcd.svg"
icon node "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/infrastructure_components/unlabeled/node.svg"
icon autoscaler "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/hpa.svg"
icon cluster-role "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/c-role.svg"
icon cluster-role-binding "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/crb.svg"
icon configmap "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/cm.svg"
icon daemonset "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/ds.svg"
icon deployment "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/deploy.svg"
icon endpoints "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/ep.svg"
icon ingress "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/ing.svg"
icon limit-range "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/limits.svg"
icon namespace "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/ns.svg"
icon network-policy "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/netpol.svg"
icon persistent-volume "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/pv.svg"
icon persistent-volume-claim "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/pvc.svg"
icon pod-security-policy "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/psp.svg"
icon replicaset "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/rs.svg"
icon resource-quota "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/quota.svg"
icon role-binding "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/rb.svg"
icon service "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/svc.svg"
icon service-account "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/sa.svg"
icon statefulset "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/sts.svg"
icon storage-class "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/sc.svg"
icon volume "https://raw.githubusercontent.com/kubernetes/community/d0476ffb364cd9dc6b007221410db3b50989ebc3/icons/svg/resources/unlabeled/vol.svg"
