look "../kubernetes.look"
text "Orders" at 40,40 style=h1
cl: cluster "prod-cluster" at 216,96 936x304
ns: namespace "orders" at 240,128 888x252
users: external "Customers" sub="browser, app" at 40,192
ing: node "Ingress" sub="nginx" at 264,192 icon=ing
svc: node "orders-svc" sub="ClusterIP" at 496,192 icon=svc
dep: focal "orders" sub="Deployment, 3 pods" at 728,192 icon=deploy
db: store "orders-db" sub="StatefulSet" at 960,192 icon=sts
hpa: node "Autoscaler" sub="2 to 10 pods" at 728,296 icon=hpa
users -> ing style=link
ing -> svc "HTTP"
svc -> dep "routes" style=primary
dep -> db "writes" style=primary
hpa.top -> dep.bottom "scales"
