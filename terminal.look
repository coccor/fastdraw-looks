// Terminal: one monospace face (JetBrains Mono) on near-black, square boxes in thin grey, a double border for the subject
// like a box drawn with line characters, faint scan lines, and phosphor green for the subject and the main path. Same
// style names as the built-in look.

canvas paper=paper dots=none bars=ink/0.02 bargap=3

color paper  #0e1111
color card   #131919
color ink    #d6e2d9
color muted  #8fa39a
color soft   #5d6f67
color accent #4ef08c
color link   #6cc7ff
color teal   #5ee0d0
color amber  #f2c66d
color rose   #ff7a85
color violet #c4a3ff

font sans  "JetBrains Mono" "https://cdn.jsdelivr.net/fontsource/fonts/jetbrains-mono@5.3.0/latin-{weight}-normal.ttf"
font mono  "JetBrains Mono" "https://cdn.jsdelivr.net/fontsource/fonts/jetbrains-mono@5.3.0/latin-{weight}-normal.ttf"
font serif "JetBrains Mono" "https://cdn.jsdelivr.net/fontsource/fonts/jetbrains-mono@5.3.0/latin-{weight}-normal.ttf"

// ---- boxes ----------------------------------------------------------------
style node shape=rect radius=0 size=144x64 fill=card stroke=ink/0.45 sw=1 sub.font=mono sub.color=muted title.size=11 title.weight=600 sub.size=8.5
    tag.color=muted tag.border=ink/0.3 tag.font=mono icon.color=accent icon.fill=accent/0.12
    use="default box: a backend, service, component or step"
style focal extends node fill=accent/0.08 stroke=accent sw=1 title.color=accent inner=accent inner.gap=3 inner.sw=1
    tag.color=accent tag.border=accent/0.5 ghost.color=accent/0.10
    use="the one or two elements the diagram is about"
style store extends node fill=card shape=path stroke=ink/0.45 icon.color=teal icon.fill=teal/0.12 tag.color=teal tag.border=teal/0.4
    path="M0,0.1 C0,-0.035 1,-0.035 1,0.1 L1,0.9 C1,1.035 0,1.035 0,0.9 Z M0,0.1 C0,0.235 1,0.235 1,0.1 C1,0.235 0,0.235 0,0.1"
    use="something that holds data or state"
style cloud extends node fill=link/0.06 stroke=link/0.7 icon.color=link icon.fill=link/0.12 tag.color=link tag.border=link/0.4
    use="a hosted or third-party platform"
style external extends node fill=paper stroke=ink/0.45 dash=2,3 icon.color=muted icon.fill=ink/0.06
    use="a person or system outside what you own"
style optional extends node fill=paper stroke=ink/0.3 dash=1,3 tag.color=soft tag.border=ink/0.2
    use="optional or asynchronous participant"
style sticky extends node radius=4 size=120x120 fill=amber/0.10 stroke=amber/0.6 tag.color=amber tag.border=amber/0.4 title.color=amber
    use="a yellow sticky note: an idea, comment or open question"
style sticky-orange extends sticky fill=rose/0.10 stroke=rose/0.6 title.color=rose use="an orange sticky note: a risk or issue"
style sticky-violet extends sticky fill=violet/0.10 stroke=violet/0.6 title.color=violet use="a violet sticky note: a decision or note"

// ---- flowchart shapes -----------------------------------------------------
style step extends node size=160x48 use="flowchart action"
style terminal extends node radius=24 size=160x48 fill=card stroke=ink/0.45
    use="flowchart start or end"
style terminal-focal extends terminal fill=accent/0.08 stroke=accent sw=2 title.color=accent inner=accent inner.sw=1
    use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=card stroke=ink/0.45 sw=1 title.size=11
    use="flowchart yes/no question; put the text on two short lines"

// ---- regions and markers --------------------------------------------------
style zone shape=rect radius=0 fill=none stroke=ink/0.3 sw=1 layer=back dash=2,3
    title.pos=top title.align=left title.font=mono title.size=9 title.weight=400 title.color=muted title.spacing=0.12 title.caps=1
    use="a labelled region drawn behind a group of boxes; always give WxH"
style bar shape=rect radius=2 size=8x80 fill=accent/0.12 stroke=accent/0.7 sw=1
    use="sequence diagram activation bar, centred on a lifeline; always give WxH"

style table shape=table radius=0 fill=card stroke=ink/0.45 sw=1 head.fill=accent/0.08 rule=ink/0.12
    cell.font=mono cell.size=10 detail.color=muted
    use="an entity, class or database table: a header and rows. One line per row: | id \"name\" \"type\" \"key\". Arrows can end on a row: orders.user_id -> users.id"
style matrix extends table align=center grid=1 cell.font=sans
    use="a grid of values: first row with |= for the column headings, first cell of each row is its name"
style chart shape=chart fill=none stroke=ink/0.5 sw=1 mask=0 bar.radius=2 grid.color=ink/0.1
    tick.font=mono tick.size=9 tick.color=muted
    use="axes with your numbers drawn for you: chart at x,y WxH x=\"Q1,Q2,Q3\" y=0..100, then a line per series: | bars \"Revenue\" 42 61 75"

// ---- lines ----------------------------------------------------------------
style arrow line stroke=ink/0.55 sw=1 route=ortho radius=0 label.font=mono label.size=9.5 label.color=muted label.spacing=0 label.caps=0 head=triangle
    use="default arrow"
style primary extends arrow stroke=accent sw=1.6 label.color=accent use="the main path; at most two per diagram"
style link extends arrow stroke=link label.color=link use="an HTTP or API request crossing a boundary"
style return extends arrow dash=3,3 use="a response, or something optional or asynchronous"
style relation extends relation stroke=ink/0.6 label.font=sans label.size=10 label.spacing=0 label.caps=0
style lifeline line head=none stroke=ink/0.25 sw=1 dash=4,4 route=straight use="sequence diagram lifeline"
style rule line head=none stroke=ink/0.15 sw=1 route=straight use="thin separator, e.g. above a legend"

// ---- text -----------------------------------------------------------------
style h1 text font=sans size=22 weight=700 spacing=0 color=ink use="diagram title"
style kicker text font=mono size=10 weight=500 color=accent spacing=0.12 caps=1 use="optional: a short category above the title, e.g. PROCESS"
style dek text font=sans size=13 color=muted use="optional: one line under the title saying what the diagram shows"
style eyebrow text font=mono size=8 color=muted spacing=0.14 caps=1 use="small caps label, e.g. LEGEND"
style caption text font=sans size=9.5 color=muted use="small explanatory text"
style legend extends legend rule=ink/0.15 title.font=mono item.size=9.5
style note text font=sans size=12 color=muted use="a short aside; at most two"
style small text font=mono size=9 color=muted use="technical detail: a port, path or command"

guidance "focal, terminal-focal and primary are the accent. Use the accent on at most two things in one diagram."
guidance "Never fill a shape with ink to make it stand out; use the accent, or a tint such as accent/0.14."
guidance "tag= is a 3 or 4 letter type marker in the corner of a box (EXT, EDGE, API, DB). Use it on architecture boxes, not flowchart shapes."
guidance "sub= is a short second line of detail: a product name, path, port or protocol. Names of things go in the main text."
guidance "kicker and dek are optional. Add a kicker only when the diagram belongs to a named category, and a dek only when there is one clear message; most diagrams need neither."
guidance "Finish with a legend: one statement, 'legend at x,y' followed by style=\"what it means\" for each style you used."
guidance "Everything is set in one monospace face, so keep text in boxes short: about 17 characters of a title and 20 of a second line fit a 144px box with an icon."
guidance "The page is near-black: colours given in a diagram should be light, and fills tints (accent/0.1), never solid."

// ---- icons ----------------------------------------------------------------------
