// Listing: the diagram as a line printer would put it on green-bar paper, sprocket holes and all.
// One typewriter face, names in capitals, plus signs on the corners, the subject printed in reverse.
// A FastDraw diagram is a text file; in this look the picture says so. Same style names as the built-in look.

canvas paper=paper bars=#e3f1e4 bargap=32 feed=#b9cdbb

color paper    #f6fbf6
color card     #f6fbf6
color ink      #1d2b24
color muted    #4a5d52
color soft     #8fa697
color accent   #2f8f5f
color link     #1d2b24
color teal     #1d6b4f
color amber    #8a6d00
color rose     #a33a2a
color violet   #4a3f8a

font sans  "Geist Mono"
font mono  "Geist Mono"
font serif "Geist Mono"

// ---- boxes -----------------------------------------------------------------
style node shape=rect radius=0 size=144x64 fill=card stroke=ink sw=1.4 corners=plus shade=ink/0.55 shade.size=6 shade.gap=2 shade.sw=0.8
    title.size=11 title.weight=500 title.caps=1 sub.font=mono sub.size=9 sub.color=ink tag.color=ink tag.border=ink/0.5 tag.font=mono icon.color=ink use="default box: a backend, service, component or step"
style focal extends node fill=ink inner=paper inner.sw=1.2 title.color=paper sub.color=paper tag.color=paper tag.border=paper/0.6 icon.color=paper ghost.color=paper/0.14 use="the one or two elements the diagram is about"
style store extends node inner=ink inner.gap=3.5 inner.sw=1.2 use="something that holds data or state"
style cloud extends node dash=1,3 use="a hosted or third-party platform"
style external extends node dash=6,5 shade=none use="a person or system outside what you own"
style optional extends node dash=2,4 shade=none use="optional or asynchronous participant"
style sticky extends node size=120x120 fill=#fff6c9 title.caps=0 use="a yellow sticky note: an idea, comment or open question"
style sticky-orange extends sticky fill=#ffe3d6 use="an orange sticky note: a risk or issue"
style sticky-violet extends sticky fill=#e8e4fb use="a violet sticky note: a decision or note"

// ---- flowchart shapes ------------------------------------------------------
style step extends node size=160x48 use="flowchart action"
style terminal extends node size=160x48 inner=ink inner.gap=3.5 inner.sw=0.8 use="flowchart start or end"
style terminal-focal extends terminal fill=ink inner=paper title.color=paper sub.color=paper use="the flowchart outcome that matters most"
style decision shape=diamond size=200x96 fill=card stroke=ink sw=1.4 title.size=11 title.weight=500 title.caps=1 use="flowchart yes/no question; put the text on two short lines"

// ---- regions and markers ---------------------------------------------------
style zone shape=rect radius=0 fill=none halftone=#9fc2a4 halftone.gap=4 halftone.r=0.7 stroke=none sw=0 layer=back
    title.pos=top title.dy=-11 title.fill=ink title.align=left title.font=mono title.size=10 title.weight=500 title.color=paper title.spacing=0.06 title.caps=1 use="a labelled region drawn behind a group of boxes; always give WxH"
style bar shape=rect radius=0 size=8x80 fill=ink stroke=ink sw=1 use="sequence diagram activation bar, centred on a lifeline; always give WxH"
style table shape=table radius=0 fill=card stroke=ink sw=1.4 corners=plus head.fill=ink/0.1 rule=ink/0.25
    title.size=11 title.weight=500 title.caps=1 cell.font=mono cell.size=10 detail.color=ink use="an entity, class or database table: a header and rows. One line per row: | id \"name\" \"type\" \"key\". Arrows can end on a row: orders.user_id -> users.id"
style matrix extends table align=center grid=1 use="a grid of values: first row with |= for the column headings, first cell of each row is its name"
style chart shape=chart fill=none stroke=ink sw=1.4 mask=0 bar.radius=0 grid.color=ink/0.15
    tick.font=mono tick.size=9 tick.color=ink use="axes with your numbers drawn for you: chart at x,y WxH x=\"Q1,Q2,Q3\" y=0..100, then a line per series: | bars \"Revenue\" 42 61 75"

// ---- lines -----------------------------------------------------------------
style arrow line stroke=ink sw=1.4 route=ortho radius=0 label.font=mono label.size=9 label.color=ink label.spacing=0.02 use="default arrow"
style primary extends arrow sw=3.4 double=paper double.sw=1 head.size=1.3 use="the main path; at most two per diagram"
style link extends arrow use="an HTTP or API request crossing a boundary"
style return extends arrow dash=6,5 use="a response, or something optional or asynchronous"
style relation extends relation stroke=ink sw=1.4 label.font=mono label.size=9
style lifeline line head=none stroke=ink/0.6 sw=1 dash=1,4 route=straight use="sequence diagram lifeline"
style rule line head=none stroke=ink/0.5 sw=1 dash=1,4 route=straight use="thin separator, e.g. above a legend"

// ---- text ------------------------------------------------------------------
style h1 text font=mono size=22 weight=500 color=ink spacing=0.05 caps=1 use="diagram title"
style kicker text font=mono size=10 weight=500 color=ink spacing=0.1 caps=1 use="optional: a short category above the title, e.g. PROCESS"
style dek text font=mono size=11 color=ink use="optional: one line under the title saying what the diagram shows"
style eyebrow text font=mono size=9 color=ink spacing=0.1 caps=1 use="small caps label, e.g. LEGEND"
style caption text font=mono size=9.5 color=ink use="small explanatory text"
style legend extends legend rule=ink/0.5 title.font=mono title.color=ink item.font=mono item.size=9 item.color=ink
style note text font=mono size=11 color=ink use="a short aside; at most two"
style small text font=mono size=9 color=ink use="technical detail: a port, path or command"

guidance "focal, terminal-focal and primary are the accent. Use the accent on at most two things in one diagram."
guidance "Never fill a shape with ink to make it stand out; use focal."
guidance "tag= is a 3 or 4 letter type marker in the corner of a box (EXT, EDGE, API, DB). Use it on architecture boxes, not flowchart shapes."
guidance "sub= is a short second line of detail: a product name, path, port or protocol. Names of things go in the main text."
guidance "kicker and dek are optional. Add a kicker only when the diagram belongs to a named category, and a dek only when there is one clear message; most diagrams need neither."
guidance "Finish with a legend: one statement, 'legend at x,y' followed by style=\"what it means\" for each style you used."
